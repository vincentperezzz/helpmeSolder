NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
MCP_API_KEY=
ALLOW_PUBLIC_API=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Days a guide is kept without being opened or updated before the daily cleanup deletes it (default 30).
GUIDE_RETENTION_DAYS=30
# Shared secret for the Vercel Cron cleanup job (/api/cron/cleanup); Vercel sends it as "Authorization: Bearer <value>".
# Use a long random string. Without it the cleanup endpoint returns 503.
CRON_SECRET=
