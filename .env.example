NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
MCP_API_KEY=
ALLOW_PUBLIC_API=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Days a guide is kept without being opened or updated before the daily cleanup deletes it (default 30).
GUIDE_RETENTION_DAYS=30
# Shared secret for the Vercel Cron cleanup job (/api/cron/cleanup); Vercel sends it as "Authorization: Bearer <value>".
# Use a long random string. Without it the cleanup endpoint returns 503.
CRON_SECRET=
# Password for the unlisted /admin dashboard (counts only). Password order: a password saved from /admin/settings
# (stored hashed in the admin_settings table), then this value, then the built-in default "admin".
# Signing in with the built-in default only opens the settings page until a new password is chosen.
# Use a long random string here. Sessions last 8 hours; changing the password signs everyone out.
ADMIN_PASSWORD=
# Set to true to remove the built-in default "admin". If no password is saved and ADMIN_PASSWORD is empty, /admin then returns 404.
ADMIN_DISABLE_DEFAULT_PASSWORD=
# Optional secret for the anonymous daily visitor/creator hash (see supabase/README.md). Falls back to SUPABASE_SERVICE_ROLE_KEY.
# Stored data is only day, kind and a one-way daily hash. No IP, no user agent. Kept 90 days.
ANALYTICS_SECRET=
